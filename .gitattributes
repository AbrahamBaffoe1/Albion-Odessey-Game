# Unity's YAML serializer writes a space after empty values.
Unity/**/*.meta whitespace=-blank-at-eol
Unity/**/*.asset whitespace=-blank-at-eol
Unity/**/*.unity whitespace=-blank-at-eol
Unity/**/*.mat whitespace=-blank-at-eol
Unity/**/*.prefab whitespace=-blank-at-eol
Unity/**/*.controller whitespace=-blank-at-eol
# Preserve upstream asset-license line endings and formatting.
Art/References/**/*.txt -whitespace
*.blend filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.bytes filter=lfs diff=lfs merge=lfs -text
*.bin filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
